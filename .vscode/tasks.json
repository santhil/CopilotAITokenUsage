{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: compile",
      "type": "shell",
      "command": "npm",
      "args": ["run", "compile"],
      "problemMatcher": "$tsc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "npm: watch",
      "type": "shell",
      "command": "npm",
      "args": ["run", "watch"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[.*\\].*Compilation starting",
          "endsPattern": "^\\[.*\\].*Compilation complete"
        }
      }
    },
    {
      "label": "npm: esbuild",
      "type": "shell",
      "command": "npm",
      "args": ["run", "esbuild"],
      "group": {
        "kind": "build"
      }
    },
    {
      "label": "npm: test",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "problemMatcher": []
    }
  ]
}
